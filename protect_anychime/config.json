{
  "name": "Protect AnyChime",
  "version": "0.4.8",
  "slug": "protect_anychime",
  "description": "Turn a Home Assistant speaker or speaker group into a UniFi Protect chime.",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "manual",
  "init": true,
  "ingress": true,
  "ingress_port": 48200,
  "panel_icon": "mdi:bell-outline",
  "panel_title": "Protect AnyChime",
  "host_network": true,
  "homeassistant_api": true,
  "hassio_api": false,
  "options": {
    "protect_username": "",
    "protect_password": "",
    "auto_adopt_chimes": false
  },
  "schema": {
    "protect_username": "str",
    "protect_password": "password",
    "auto_adopt_chimes": "bool"
  },
  "privileged": [
    "NET_ADMIN",
    "NET_RAW"
  ],
  "backup": "cold",
  "timeout": 30,
  "apparmor": true,
  "url": "https://github.com/bramboe/protect-anychime"
}
